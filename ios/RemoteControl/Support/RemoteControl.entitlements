<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.networking.server</key>
    <true/>
    <key>com.apple.security.networking.client</key>
    <true/>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.developer.networking.multipeer</key>
    <true/>
    <key>com.apple.developer.networking.bonjour</key>
    <array>
        <string>_remoteios._tcp</string>
    </array>
</dict>
</plist>
